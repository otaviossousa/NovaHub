<Window x:Class="NovaLite.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NovaLite.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="NovaHub • 1.0" Icon="Assets/NovaHub_White_Icon.png" Width="1160" Height="940" MinWidth="960" MinHeight="700" ResizeMode="CanResize" WindowStyle="None" WindowState="Normal" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}" WindowStartupLocation="Manual">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="50" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveSurfaceBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10,0,13,0" VerticalAlignment="Center">
          <Image x:Name="HeaderIcon" Width="34" Height="34" Source="Assets/NovaHub_White_Icon.png" Stretch="Uniform" />
          <Image x:Name="HeaderLogo" Width="132" Height="30" Margin="8,0,0,0" Source="Assets/NovaHub_Logo_White_No_Icon.png" Stretch="Uniform" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource TitleBarButton}" Click="MinimizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{DynamicResource Loc.Minimize}">
          <Viewbox Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 3,12 L 21,12" /></Viewbox>
        </Button>
        <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Click="ToggleMaximizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{DynamicResource Loc.MaximizeRestore}">
          <Viewbox Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" /></Viewbox>
        </Button>
        <Button Grid.Column="4" Style="{StaticResource TitleBarButton}" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{DynamicResource Loc.Close}">
          <Viewbox Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6,6 L 18,18 M 18,6 L 6,18" /></Viewbox>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="32,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Height="38" Margin="0,0,0,4">
      <Button x:Name="SettingsButton" Width="38" Height="38" Padding="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ShowSettings" AutomationProperties.Name="{DynamicResource Loc.OpenSettings}">
        <Viewbox Width="20" Height="20">
          <Canvas Width="24" Height="24">
            <Path Fill="{DynamicResource AccentBrush}" Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.54,9.37 L19.54,5.9 L17.04,6.91 C16.54,6.5 15.98,6.17 15.37,5.91 L15,3.25 L11,3.25 L10.63,5.91 C10.02,6.17 9.46,6.51 8.96,6.91 L6.46,5.9 L4.46,9.37 L6.58,11.02 C6.53,11.34 6.5,11.67 6.5,12 C6.5,12.33 6.53,12.66 6.58,12.98 L4.46,14.63 L6.46,18.1 L8.96,17.09 C9.46,17.5 10.02,17.83 10.63,18.09 L11,20.75 L15,20.75 L15.37,18.09 C15.98,17.83 16.54,17.49 17.04,17.09 L19.54,18.1 L21.54,14.63 Z M13,15.5 C11.07,15.5 9.5,13.93 9.5,12 C9.5,10.07 11.07,8.5 13,8.5 C14.93,8.5 16.5,10.07 16.5,12 C16.5,13.93 14.93,15.5 13,15.5 Z">
              <Path.RenderTransform><TranslateTransform X="-1" /></Path.RenderTransform>
            </Path>
          </Canvas>
        </Viewbox>
      </Button>
    </Grid>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid x:Name="Pages">
          <StackPanel x:Name="TestPage">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="20">
              <StackPanel>
                <UniformGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SlotTabs" Columns="4" Margin="0,0,0,14" />
                <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NovaLite.Desktop" x:Name="EmptyState" Height="540" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.ConnectController}">
                  <StackPanel HorizontalAlignment="Center" Margin="0,24,0,8">
                    <Border Width="62" Height="62" Margin="0,0,0,18" HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="31">
                      <TextBlock Text="↻" Foreground="{DynamicResource AccentBrush}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                    </Border>
                    <local:ControllerView Width="510" Height="320" Opacity="0.72" IsHitTestVisible="False" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Loc.ConnectController}" HorizontalAlignment="Stretch" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="24,8,24,0" />
                </StackPanel>
                <Grid x:Name="TesterContent">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <ComboBox x:Name="DeviceSelector" SelectionChanged="SelectionChanged" Margin="0,8,0,10" AutomationProperties.Name="Selecionar controle e fonte de entradas" Visibility="Collapsed" />
                    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NovaLite.Desktop">
                      <UniformGrid x:Name="ButtonGrid" Columns="4" Margin="0,4,0,6" />
                      <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <local:StickPlot x:Name="LeftPlot" Height="144" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <local:StickPlot x:Name="RightPlot" Height="144" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <ToggleButton Content="{DynamicResource Loc.PrecisionTest}" Click="ToggleCircularity" Style="{StaticResource CircularityToggle}" x:Name="CircularityButton" />
                          <ToggleButton Content="{DynamicResource Loc.CircularityTest}" Click="ToggleRotationTest" Style="{StaticResource CircularityToggle}" x:Name="RotationTestButton" Margin="0" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <Border x:Name="VibrationPanel" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="{DynamicResource Loc.Vibration}" FontWeight="SemiBold" />
                          <TextBlock Text="{DynamicResource Loc.OneSecond}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="12" />
                        </DockPanel>
                        <DockPanel Margin="0,8">
                          <TextBlock DockPanel.Dock="Right" Width="42" Text="{Binding ElementName=Intensity, Path=Value, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                          <Slider x:Name="Intensity" Minimum="0" Maximum="100" Value="25" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="{DynamicResource Loc.VibrationIntensityA11y}" />
                        </DockPanel>
                        <UniformGrid x:Name="MotorButtons" Columns="4">
                          <local:ProgressButton Content="{DynamicResource Loc.Left}" Tag="left" Click="StartMotor" Padding="6,8" Style="{StaticResource {x:Type Button}}" Background="Transparent" FontSize="12" />
                          <local:ProgressButton Content="{DynamicResource Loc.Right}" Tag="right" Click="StartMotor" Padding="6,8" Style="{StaticResource {x:Type Button}}" Background="Transparent" FontSize="12" />
                          <local:ProgressButton Content="{DynamicResource Loc.Both}" Tag="both" Click="StartMotor" Padding="6,8" Style="{StaticResource {x:Type Button}}" Background="Transparent" FontSize="12" />
                          <Button x:Name="InfiniteButton" Content="{DynamicResource Loc.Continuous}" Tag="infinite" Click="QuickVibration" Padding="4,8" FontSize="11" />
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock x:Name="ConnectionText" Text="{DynamicResource Loc.Connection}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                          <Button x:Name="ConnectionButton" Click="ChooseConnection" Width="34" Height="30" Padding="4" Margin="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{DynamicResource Loc.ConnectionTypeA11y}">
                            <Grid Width="24" Height="22">
                              <Viewbox x:Name="UsbCableConnectionIcon" Visibility="Collapsed">
                                <Canvas Width="28" Height="24">
                                  <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3,19 C 7,19 7,13 11,13 L 18,13 M 18,8 L 18,18 M 18,8 L 15,11 M 18,8 L 21,11 M 18,8 L 18,3" />
                                  <Path Fill="{DynamicResource AccentBrush}" Data="M 18,1 L 15.5,5 L 20.5,5 Z" />
                                  <Rectangle Canvas.Left="20" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" RadiusX="0.5" RadiusY="0.5" />
                                  <Ellipse Canvas.Left="8.5" Canvas.Top="10.5" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                                </Canvas>
                              </Viewbox>
                              <Viewbox x:Name="DongleConnectionIcon" Visibility="Collapsed">
                                <Canvas Width="30" Height="22">
                                  <Rectangle Canvas.Left="2" Canvas.Top="4" Width="20" Height="14" RadiusX="4" RadiusY="4" Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                  <Rectangle Canvas.Left="22" Canvas.Top="7" Width="6" Height="8" Fill="Transparent" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                  <Ellipse Canvas.Left="6" Canvas.Top="8" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" />
                                </Canvas>
                              </Viewbox>
                              <Viewbox x:Name="BluetoothConnectionIcon" Visibility="Collapsed">
                                <Canvas Width="20" Height="28">
                                  <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M 8,2 L 16,9 L 5,19 M 8,26 L 16,19 L 5,9 M 8,2 L 8,26" />
                                </Canvas>
                              </Viewbox>
                              <TextBlock x:Name="UnknownConnectionIcon" Text="?" Visibility="Visible" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </StackPanel>
                      </Border>
                      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource Loc.Battery}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                          <Border BorderBrush="{DynamicResource InactiveBrush}" BorderThickness="1.5" CornerRadius="4" Padding="3">
                            <WrapPanel x:Name="BatteryCategories" />
                          </Border>
                          <Border Width="3" Height="10" Background="{DynamicResource InactiveBrush}" CornerRadius="0,2,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <local:ControllerView x:Name="ControllerDrawing" Height="370" Margin="0,40,0,0" AutomationProperties.Name="Nova Lite: botões e analógicos ao vivo" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border x:Name="ButtonCombinationsPanel" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Loc.ButtonCombinations}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <UniformGrid Columns="5" Margin="-4,0">
                  <Border Height="154" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Loc.VibrationIntensity}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                      <local:CombinationGlyph Grid.Row="1" Kind="Vibration" Height="68" Margin="0,2" />
                      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.VibrationIntensityHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Height="154" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Loc.ConnectionMode}" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" HorizontalAlignment="Center" />
                      <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.HoldTwoSeconds}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" />
                        <local:CombinationGlyph Kind="Connection" Height="56" Margin="0,1,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.ConnectionModeHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Height="154" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Loc.StickDeadzone}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                      <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.HoldTwoSeconds}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" />
                        <local:CombinationGlyph Kind="Deadzone" Height="56" Margin="0,1,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.StickDeadzoneHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Height="154" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Loc.SwapLayout}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                      <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.HoldTwoSeconds}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" />
                        <local:CombinationGlyph Kind="Layout" Height="56" Margin="0,1,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.SwapLayoutHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Height="154" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="Turbo" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" HorizontalAlignment="Center" />
                      <local:CombinationGlyph Grid.Row="1" Kind="Turbo" Height="68" Margin="0,2" />
                      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.TurboHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="28" Margin="0,10,0,24">
              <StackPanel>
                <Button Content="{DynamicResource Loc.Back}" Click="HideSettings" HorizontalAlignment="Left" Margin="0,0,0,20" Padding="12,7" />
                <TextBlock Text="{DynamicResource Loc.Settings}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Loc.Appearance}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,26,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.ApplicationTheme}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource Loc.ApplicationThemeHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" Margin="0" Padding="10,7" VerticalAlignment="Center" SelectionChanged="ThemeChanged" AutomationProperties.Name="{DynamicResource Loc.ApplicationTheme}" />
                  </Grid>
                </Border>
                <TextBlock Text="{DynamicResource Loc.Language}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,22,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource Loc.Language}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource Loc.LanguageHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,20,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" Margin="0" Padding="10,7" VerticalAlignment="Center" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource Loc.LanguageA11y}" />
                  </Grid>
                </Border>
                <TextBlock Text="{DynamicResource Loc.UsefulLinks}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,22,0,8" />
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,10">
                  <StackPanel>
                    <Grid Margin="0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Loc.OfficialManual}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.OfficialManualHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{DynamicResource Loc.OpenManual}" Tag="https://gamesir.com/pt-BR/support/manuals/gamesir-nova-lite" Click="OpenOfficial" Margin="0" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />
                    <Grid Margin="0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Loc.Repository}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.RepositoryHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{DynamicResource Loc.OpenRepository}" Tag="https://github.com/otaviossousa/NovaHub" Click="OpenOfficial" Margin="0" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />
                    <Grid Margin="0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource Loc.Developer}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Loc.DeveloperName}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{DynamicResource Loc.OpenProfile}" Tag="https://github.com/otaviossousa" Click="OpenOfficial" Margin="0" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource Loc.Contribution}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,22,0,8" />
                <Border Background="{DynamicResource SelectedSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                      <TextBlock Text="{DynamicResource Loc.ContributionTitle}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{DynamicResource Loc.ContributionHelp}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource Loc.SupportProject}" Tag="https://github.com/sponsors/otaviossousa" Click="OpenOfficial" Margin="0" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Grid>
</Window>
